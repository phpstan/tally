{
	"name": "phpstan/tally",
	"description": "PHP benchmarking framework that doesn't care about wall-clock time or how fast your CPU is.",
	"license": [
		"MIT"
	],
	"keywords": ["benchmark", "performance", "codspeed"],
	"require": {
		"php": "^8.2"
	},
	"require-dev": {
		"infection/infection": "^0.35.10",
		"php-parallel-lint/php-parallel-lint": "^1.4",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5 || ^12.5",
		"shipmonk/dead-code-detector": "^1.4"
	},
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"infection/extension-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"Tally\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Tally\\Bench\\": "bench/",
			"Tally\\Build\\": "build/",
			"Tally\\Examples\\": "examples/",
			"Tally\\Tests\\": "tests/"
		}
	},
	"bin": [
		"bin/tally"
	]
}
