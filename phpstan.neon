includes:
	- vendor/phpstan/phpstan-deprecation-rules/rules.neon
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon
	- vendor/phpstan/phpstan-strict-rules/rules.neon
	- phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
	level: max
	tmpDir: tmp

	paths:
		- bin/tally
		- src
		- tests

	excludePaths:
		- tests/*/data/*

	ignoreErrors:
		-
			# These rules are for PHPStan extensions, which the PHPStan\ namespace makes Tally look like.
			# Tally reflects the benchmarks it runs at runtime, and its own classes are not PHPStan's API.
			identifiers:
				- phpstanApi.classConstant
				- phpstanApi.constructor
				- phpstanApi.method
				- phpstanApi.runtimeReflection
