includes:
	- vendor/phpstan/phpstan-deprecation-rules/rules.neon
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon
	- vendor/phpstan/phpstan-strict-rules/rules.neon
	- vendor/shipmonk/dead-code-detector/rules.neon
	- phar://phpstan.phar/conf/bleedingEdge.neon

parameters:
	level: max
	checkUninitializedProperties: true
	checkBenevolentUnionTypes: true
	reportPossiblyNonexistentConstantArrayOffset: true
	reportAnyTypeWideningInVarTag: true
	checkMissingCallableSignature: true
	checkTooWideReturnTypesInProtectedAndPublicMethods: true
	checkMissingOverrideMethodAttribute: true
	rememberPossiblyImpureFunctionValues: false
	reportPossiblyNonexistentGeneralArrayOffset: true
	reportAlwaysTrueInLastCondition: true
	reportWrongPhpDocTypeInVarTag: true
	exceptions:
		uncheckedExceptionClasses:
			- Error
			- InvalidArgumentException
			# encoding with JSON_THROW_ON_ERROR fails only on a bug; decoding catches it
			- JsonException
			- LogicException
			- ReflectionException
			- RuntimeException
		check:
			missingCheckedExceptionInThrows: true
			tooWideThrowType: true
			throwTypeCovariance: true
	tmpDir: tmp

	stubFiles:
		- build/stubs/FFI.stub

	paths:
		- bin/tally
		- bench
		- tally.php
		- build
		- examples
		- src
		- tests

	excludePaths:
		- tests/Fixtures/*

services:
	-
		class: Tally\Build\PHPStan\BenchmarkUsageProvider
		tags:
			- shipmonk.deadCode.memberUsageProvider

rules:
	- Tally\Build\PHPStan\NoDefaultParameterValueRule
	- Tally\Build\PHPStan\NoDefaultPropertyValueRule
