#!/usr/bin/env php
<?php declare(strict_types = 1);

// Stands in for the codspeed CLI in the tests. Like codspeed run --mode=simulation, it joins the
// command after -- into a shell command and writes a callgrind profile into --profile-folder.
// TALLY_FAKE_COUNTS maps case IDs to the instructions and cycles of the case and its baseline,
// like {"App\\FooBench::benchFoo": [1100, 1500, 100, 150]}; a case not in it gets no parts.

$arguments = array_slice($argv, 1);
$separator = array_search('--', $arguments, true);
if (($arguments[0] ?? null) !== 'run' || $separator === false) {
	fwrite(STDERR, "Usage: codspeed run [options] -- <command>\n");
	exit(2);
}

$profileFolder = null;
foreach (array_slice($arguments, 0, $separator) as $option) {
	if (str_starts_with($option, '--profile-folder=')) {
		$profileFolder = substr($option, strlen('--profile-folder='));
	}
}

$command = implode(' ', array_slice($arguments, $separator + 1));
passthru($command, $exitCode);

$counts = json_decode((string) getenv('TALLY_FAKE_COUNTS'), true) ?? [];
$part = 1;
$profile = "# callgrind format\nversion: 1\ncreator: fake-codspeed\n";
foreach ($counts as $id => [$instructions, $cycles, $baselineInstructions, $baselineCycles]) {
	if (!str_contains($command, escapeshellarg('--case=' . $id))) {
		continue;
	}

	foreach ([[$id . '#baseline', $baselineInstructions, $baselineCycles], [$id, $instructions, $cycles]] as [$name, $ir, $cycleCount]) {
		// cycles are estimated from instructions and misses: Ir + 10 * I1mr
		$profile .= sprintf("part: %d\ndesc: Trigger: Client Request: %s\nevents: Ir I1mr\ntotals: %d %d\n\n", $part++, $name, $ir, ($cycleCount - $ir) / 10);
	}
}
file_put_contents($profileFolder . '/' . getmypid() . '.out', $profile);

if ($exitCode !== 0) {
	echo "  ✗ failed to execute the benchmark process, exit code: {$exitCode}\n";
	exit(1);
}
