<?xml version="1.0"?>
<ruleset name="Tally Coding Standard">
	<config name="php_version" value="80500"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="encoding" value="utf-8"/>
	<arg name="tab-width" value="4"/>
	<arg name="cache" value="tmp/phpcs"/>
	<arg value="sp"/>

	<rule ref="build-cs/phpcs.xml"/>
	<rule ref="SlevomatCodingStandard.Files.TypeNameMatchesFileName">
		<properties>
			<property name="rootNamespaces" type="array">
				<element key="src" value="PHPStan\Tally"/>
				<element key="tests" value="PHPStan\Tally"/>
				<element key="examples" value="PHPStan\Tally\Examples"/>
			</property>
		</properties>
	</rule>
	<exclude-pattern>tests/*/data/*</exclude-pattern>
</ruleset>
