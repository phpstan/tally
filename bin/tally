#!/usr/bin/env php
<?php declare(strict_types = 1);

use Tally\Cli\Application;
use Tally\Cli\ApplicationFactory;

(static function (): void {
	// set by Composer's binary proxy since Composer 2.2
	$autoloadFiles = isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])
		? [$GLOBALS['_composer_autoload_path']]
		: [__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'];
	foreach ($autoloadFiles as $autoloadFile) {
		if (is_file($autoloadFile)) {
			require_once $autoloadFile;
			break;
		}
	}

	if (!class_exists(Application::class)) {
		fwrite(STDERR, "Run composer install to install Tally's autoloader.\n");
		exit(2);
	}

	$arguments = [];
	$argv = $_SERVER['argv'] ?? [];
	foreach (is_array($argv) ? $argv : [] as $argument) {
		if (!is_string($argument)) {
			continue;
		}

		$arguments[] = $argument;
	}

	$workingDirectory = getcwd();
	if ($workingDirectory === false) {
		fwrite(STDERR, "Cannot read the working directory.\n");
		exit(2);
	}

	$environment = getenv();
	// https://no-color.org
	$noColor = ($environment['NO_COLOR'] ?? '') !== '';
	$colors = stream_isatty(STDOUT) && !$noColor;
	$errorColors = stream_isatty(STDERR) && !$noColor;

	// built by build/build-codspeed.sh, the releases include it
	$codspeed = sprintf('%s/codspeed/%s-%s', dirname(__DIR__), strtolower(PHP_OS_FAMILY), php_uname('m'));

	exit((new ApplicationFactory())->create(STDOUT, STDERR, $workingDirectory, $environment, $colors, $errorColors, PHP_BINARY, __FILE__, $codspeed)->run($arguments));
})();
